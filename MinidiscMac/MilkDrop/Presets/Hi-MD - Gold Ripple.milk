[preset00]
// Hi-MD's own preset: a gold ring that ripples outward on the bass.
fDecay=0.960000
fGammaAdj=1.800000
nWaveMode=0
bWaveThick=1
bAdditiveWaves=1
bMaximizeWaveColor=1
fWaveAlpha=0.900000
fWaveScale=1.200000
fWaveSmoothing=0.600000
zoom=1.000000
rot=0.000000
warp=0.200000
wave_r=1.000000
wave_g=0.780000
wave_b=0.250000
ob_size=0.000000
ib_size=0.000000
per_frame_1=wave_r = 0.85 + 0.15*sin(time*0.7);
per_frame_2=wave_g = 0.62 + 0.12*sin(time*0.9) + 0.1*bass_att;
per_frame_3=wave_b = 0.18 + 0.1*treb_att;
per_frame_4=rot = 0.01*sin(time*0.3);
per_frame_5=q1 = 0.025*bass_att;
per_pixel_1=zoom = 1.01 + q1*sin(rad*16 - time*3);
