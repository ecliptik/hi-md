[preset00]
// Hi-MD's own preset: a disc spinning at the centre, swelling on the beat, over a soft wave.
fDecay=0.950000
fGammaAdj=1.700000
nWaveMode=0
bAdditiveWaves=1
fWaveAlpha=0.500000
fWaveScale=0.800000
zoom=1.010000
warp=0.100000
wave_r=0.700000
wave_g=0.600000
wave_b=0.400000
ob_size=0.000000
ib_size=0.000000
per_frame_1=wave_g = 0.5 + 0.2*sin(time*0.6);
shapecode_0_enabled=1
shapecode_0_sides=64
shapecode_0_additive=0
shapecode_0_thickOutline=1
shapecode_0_textured=0
