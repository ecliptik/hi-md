shapecode_0_g2=0.220000
shapecode_0_b2=0.100000
shapecode_0_a2=0.900000
shapecode_0_border_r=1.000000
shapecode_0_border_g=0.900000
shapecode_0_border_b=0.600000
shapecode_0_border_a=0.800000
shape_0_per_frame1=ang = time*0.6;
shape_0_per_frame2=rad = 0.3 + 0.03*bass_att;
