[preset00]
// Hi-MD's own preset: a line across the middle in shifting colours, mirrored and echoed.
fDecay=0.930000
fGammaAdj=1.600000
fVideoEchoZoom=1.010000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1
nWaveMode=6
bWaveThick=1
fWaveAlpha=0.850000
fWaveScale=1.400000
wave_y=0.500000
zoom=0.990000
ob_size=0.000000
ib_size=0.000000
per_frame_1=wave_r = 0.5 + 0.5*sin(time*1.1);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*1.3 + 2);
per_frame_3=wave_b = 0.5 + 0.5*sin(time*1.7 + 4);
per_frame_4=sx = 1.0 + 0.02*treb_att;
per_frame_5=sy = 1.0 + 0.02*bass_att;
