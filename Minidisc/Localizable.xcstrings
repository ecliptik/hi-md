    "Open Minidisc on your iPhone to connect to your music server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Minidisc auf deinem iPhone, um dich mit deinem Musikserver zu verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το Minidisc στο iPhone σας για να συνδεθείτε με τον διακομιστή μουσικής σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Minidisc en tu iPhone para conectarte a tu servidor de música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Minidisc sur votre iPhone pour vous connecter à votre serveur de musique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Minidisc sul tuo iPhone per collegarti al tuo server musicale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでMinidiscを開いて音楽サーバに接続してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打开 Minidisc 以连接你的音乐服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打開 Minidisc 以連接你的音樂伺服器。"
          }
        }
      }
    },
    "Play something on your iPhone and it will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiel etwas auf deinem iPhone ab, dann erscheint es hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παίξτε κάτι στο iPhone σας και θα εμφανιστεί εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce algo en tu iPhone y aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez quelque chose sur votre iPhone et cela apparaîtra ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci qualcosa sul tuo iPhone e apparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで何か再生すると、ここに表示されます。"
          }
