    "Full indexing requires an unmetered, unconstrained network connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die vollständige Indizierung ist eine Netzwerkverbindung ohne Datenbeschränkung oder Datensparmodus erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πλήρης ευρετηρίαση απαιτεί σύνδεση δικτύου χωρίς χρέωση βάσει χρήσης και χωρίς λειτουργία εξοικονόμησης δεδομένων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La indexación completa requiere una conexión sin tarifa por consumo ni modo de ahorro de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indexation complète nécessite une connexion sans facturation à l’usage ni mode économie de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indicizzazione completa richiede una connessione non a consumo e senza modalità di risparmio dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全なインデックス作成には、従量制課金ではなく省データモードも無効なネットワーク接続が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整索引需要非按流量计费且未启用低数据模式的网络连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整索引需要非按流量計費且未啟用低數據模式的網路連線。"
          }
        }
      }
    },
