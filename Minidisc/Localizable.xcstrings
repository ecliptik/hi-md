    "System follows your Mac's light or dark setting. The accent colour marks the playing song, buttons and selections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der hellen oder dunklen Darstellung deines Mac. Die Akzentfarbe markiert den laufenden Titel, Tasten und Auswahlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή Σύστημα ακολουθεί τη φωτεινή ή σκοτεινή εμφάνιση του Mac. Το χρώμα έμφασης σημειώνει το τραγούδι που παίζει, τα κουμπιά και τις επιλογές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema sigue el aspecto claro u oscuro de tu Mac. El color de realce marca la canción que suena, los botones y las selecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système suit l’apparence claire ou sombre de votre Mac. La couleur d’accentuation marque le titre en cours, les boutons et les sélections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue l’aspetto chiaro o scuro del Mac. Il colore di evidenziazione indica il brano in riproduzione, i pulsanti e le selezioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」はMacのライト/ダークの設定に従います。アクセントカラーは再生中の曲、ボタン、選択項目に使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统”会跟随 Mac 的浅色或深色设置。强调色用于标记正在播放的歌曲、按钮和所选内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「系統」會跟隨 Mac 的淺色或深色設定。強調色用於標示正在播放的歌曲、按鈕和所選項目。"
          }
        }
      }
    },
    "The music stays in your library on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Musik bleibt in deiner Mediathek auf dem Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μουσική παραμένει στη βιβλιοθήκη σας στον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música sigue en tu biblioteca del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique reste dans votre bibliothèque sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica resta nella tua libreria sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽はサーバ上のライブラリに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐仍保留在服务器上的资料库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音樂仍保留在伺服器上的資料庫中。"
          }
        }
      }
    },
    "The server transcodes to the chosen tier. Original streams your files untouched (lossless). Applies to the next track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wandelt in die gewählte Stufe um. „Original“ streamt deine Dateien unverändert (verlustfrei). Gilt ab dem nächsten Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής μετατρέπει στο επιλεγμένο επίπεδο. Η επιλογή Πρωτότυπο μεταδίδει τα αρχεία σας αναλλοίωτα (χωρίς απώλειες). Ισχύει από το επόμενο κομμάτι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor convierte al nivel elegido. Original transmite tus archivos sin cambios (sin pérdida). Se aplica a la siguiente pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur convertit au niveau choisi. Original diffuse vos fichiers tels quels (sans perte). S’applique au titre suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server converte al livello scelto. Originale trasmette i file senza modifiche (lossless). Vale dal brano successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバは選択した品質に変換します。「オリジナル」はファイルをそのまま(ロスレスで)ストリーミングします。次の曲から適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器会转码为所选音质。“原始”会按原样（无损）串流你的文件。将从下一首开始生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器會轉碼為所選音質。「原始」會按原樣（無損）串流你的檔案。將從下一首開始生效。"
          }
        }
      }
    },
