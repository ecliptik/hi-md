    "Downloaded tracks are stored permanently and available offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Titel werden dauerhaft gespeichert und sind offline verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ληφθέντα κομμάτια αποθηκεύονται μόνιμα και είναι διαθέσιμα εκτός σύνδεσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pistas descargadas se guardan de forma permanente y están disponibles sin conexión."
