    "Plays every song at a similar volume, using its ReplayGain tags." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt jeden Song in ähnlicher Lautstärke ab, anhand seiner ReplayGain-Tags."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαράγει κάθε τραγούδι σε παρόμοια ένταση, με βάση τις ετικέτες ReplayGain του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
