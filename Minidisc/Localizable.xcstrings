          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReplayGainタグを使って、どの曲も同じくらいの音量で再生します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
