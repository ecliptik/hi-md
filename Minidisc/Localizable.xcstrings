    "Converted music streams as %@. Formats this device can't play are always converted. Changes apply from the next song." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konvertierte Musik wird als %@ gestreamt. Formate, die dieses Gerät nicht abspielen kann, werden immer konvertiert. Änderungen gelten ab dem nächsten Song."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετατρεπόμενη μουσική μεταδίδεται ως %@. Οι μορφές που δεν μπορεί να αναπαραγάγει αυτή η συσκευή μετατρέπονται πάντα. Οι αλλαγές ισχύουν από το επόμενο τραγούδι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música convertida se transmite en %@. Los formatos que este dispositivo no puede reproducir siempre se convierten. Los cambios se aplican desde la siguiente canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique convertie est diffusée en %@. Les formats que cet appareil ne peut pas lire sont toujours convertis. Les changements s’appliquent dès le morceau suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica convertita viene riprodotta in %@. I formati che questo dispositivo non può riprodurre vengono sempre convertiti. Le modifiche valgono dal brano successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換された音楽は %@ でストリーミングされます。このデバイスで再生できない形式は常に変換されます。変更は次の曲から適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转换后的音乐以 %@ 串流。此设备无法播放的格式始终会被转换。更改将从下一首歌开始生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉換後的音樂以 %@ 串流。此裝置無法播放的格式一律會轉換。變更會從下一首歌開始生效。"
          }
        }
      }
    },
