    "Type in the search field to find artists, albums and songs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib etwas in das Suchfeld ein, um Künstler, Alben und Titel zu finden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολογήστε στο πεδίο αναζήτησης για να βρείτε καλλιτέχνες, άλμπουμ και τραγούδια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe en el campo de búsqueda para encontrar artistas, álbumes y canciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez du texte dans le champ de recherche pour trouver des artistes, des albums et des titres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi nel campo di ricerca per trovare artisti, album e brani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドに入力して、アーティスト、アルバム、曲を探します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜索栏中输入内容，查找艺人、专辑和歌曲。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜尋欄位中輸入內容，尋找藝人、專輯和歌曲。"
          }
        }
      }
    },
