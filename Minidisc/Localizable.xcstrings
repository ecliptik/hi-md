            "value" : "No has descargado nada de este artista. Descarga álbumes mientras estés en línea para verlos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de cet artiste n'est téléchargé. Téléchargez des albums lorsque vous êtes en ligne pour les retrouver ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai scaricato nulla di questo artista. Scarica album mentre sei online per vederli qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアーティストの曲はダウンロードされていません。オンラインのうちにアルバムをダウンロードすると、ここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未下载这位艺人的任何内容。请在联网时下载专辑，以便在此浏览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未下載這位藝人的任何內容。請在連網時下載專輯，以便在此瀏覽。"
          }
        }
      }
    },
