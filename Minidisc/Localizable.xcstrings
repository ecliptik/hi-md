    "All indexed metadata and cached album recommendations will be removed. Downloads, favorites, playlists on your server, and playback history are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle indizierten Metadaten und zwischengespeicherten Albumempfehlungen werden entfernt. Downloads, Favoriten, Playlists auf deinem Server und der Wiedergabeverlauf bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αφαιρεθούν όλα τα μεταδεδομένα του ευρετηρίου και οι αποθηκευμένες προτάσεις άλμπουμ. Οι λήψεις, τα αγαπημένα, οι λίστες αναπαραγωγής στον διακομιστή σας και το ιστορικό ακρόασης δεν επηρεάζονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los metadatos indexados y las recomendaciones de álbumes en caché. Las descargas, los favoritos, las listas del servidor y el historial de reproducción no se verán afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les métadonnées indexées et les recommandations d’albums en cache seront supprimées. Les téléchargements, les favoris, les playlists sur votre serveur et l’historique d’écoute ne seront pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi tutti i metadati indicizzati e i consigli sugli album nella cache. I download, i preferiti, le playlist sul server e la cronologia di ascolto non verranno modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インデックス内のすべてのメタデータとキャッシュ済みのおすすめアルバムを削除します。ダウンロード、お気に入り、サーバー上のプレイリスト、再生履歴には影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除所有已索引的元数据和缓存的专辑推荐。下载内容、收藏、服务器上的播放列表和播放历史不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移除所有已索引的中繼資料和快取的專輯推薦。下載內容、喜好項目、伺服器上的播放列表和播放記錄不受影響。"
          }
        }
      }
    },
