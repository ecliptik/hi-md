    "Search needs your server. Downloaded music is in Downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche braucht deinen Server. Geladene Musik findest du unter „Downloads“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναζήτηση χρειάζεται τον διακομιστή σας. Η μουσική που έχετε κατεβάσει βρίσκεται στις Λήψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda necesita tu servidor. La música descargada está en Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche a besoin de votre serveur. La musique téléchargée se trouve dans Téléchargements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca richiede il tuo server. La musica scaricata è in Download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索にはサーバが必要です。ダウンロードした音楽は「ダウンロード」にあります。"
