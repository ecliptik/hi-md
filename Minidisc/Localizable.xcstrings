    "The hostname could not be resolved. Check the URL, DNS settings, and local network access in iOS Settings › Privacy › Local Network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hostname konnte nicht aufgelöst werden. URL, DNS-Einstellungen und lokalen Netzwerkzugriff in iOS Einstellungen › Datenschutz › Lokales Netzwerk prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάλυση του ονόματος κεντρικού υπολογιστή. Ελέγξτε το URL, τις ρυθμίσεις DNS και την πρόσβαση στο τοπικό δίκτυο στο iOS Ρυθμίσεις › Απόρρητο › Τοπικό δίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo resolver el nombre de host. Comprueba la URL, los ajustes de DNS y el acceso a la red local en Ajustes de iOS › Privacidad › Red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'hôte n'a pas pu être résolu. Vérifiez l'URL, les réglages DNS et l'accès au réseau local dans Réglages iOS › Confidentialité › Réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile risolvere l'hostname. Controlla l'URL, le impostazioni DNS e l'accesso alla rete locale in Impostazioni iOS › Privacy › Rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト名を解決できませんでした。URL、DNS設定、およびiOSの設定 › プライバシー › ローカルネットワークでのローカルネットワークアクセスを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解析主机名。请检查 URL、DNS 设置以及 iOS 设置 › 隐私 › 本地网络 中的本地网络访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法解析主機名稱。請檢查 URL、DNS 設定，以及 iOS「設定」›「隱私權」›「區域網路」中的區域網路存取權限。"
          }
        }
      }
    },
    "The index stores searchable metadata for artists, albums, songs, playlists, and album recommendations. Full indexing requires an unmetered, unconstrained connection. Downloads, favorites, and playback history are stored separately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Index speichert durchsuchbare Metadaten zu Künstlern, Alben, Titeln, Playlists und Albumempfehlungen. Die vollständige Indizierung erfordert eine Verbindung ohne Datenbeschränkung oder Datensparmodus. Downloads, Favoriten und der Wiedergabeverlauf werden separat gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ευρετήριο αποθηκεύει αναζητήσιμα μεταδεδομένα για καλλιτέχνες, άλμπουμ, τραγούδια, λίστες αναπαραγωγής και προτάσεις άλμπουμ. Η πλήρης ευρετηρίαση απαιτεί σύνδεση χωρίς χρέωση βάσει χρήσης και χωρίς εξοικονόμηση δεδομένων. Οι λήψεις, τα αγαπημένα και το ιστορικό ακρόασης αποθηκεύονται ξεχωριστά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El índice guarda metadatos de búsqueda de artistas, álbumes, canciones, listas y recomendaciones de álbumes. La indexación completa requiere una conexión sin tarifa por consumo ni modo de ahorro de datos. Las descargas, los favoritos y el historial de reproducción se guardan por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’index stocke les métadonnées permettant de rechercher des artistes, des albums, des titres, des playlists et des recommandations d’albums. L’indexation complète nécessite une connexion sans facturation à l’usage ni mode économie de données. Les téléchargements, les favoris et l’historique d’écoute sont stockés séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indice memorizza metadati ricercabili per artisti, album, brani, playlist e album consigliati. L’indicizzazione completa richiede una connessione non a consumo e senza risparmio dati. I download, i preferiti e la cronologia di ascolto sono memorizzati separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インデックスには、アーティスト、アルバム、曲、プレイリスト、おすすめアルバムの検索用メタデータが保存されます。完全なインデックス作成には、従量制課金ではなく省データモードも無効な接続が必要です。ダウンロード、お気に入り、再生履歴は別に保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "索引存储艺人、专辑、歌曲、播放列表和专辑推荐的可搜索元数据。完整索引需要非按流量计费且未启用低数据模式的连接。下载内容、收藏和播放历史单独存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "索引儲存藝人、專輯、歌曲、播放列表和專輯推薦的可搜尋中繼資料。完整索引需要非按流量計費且未啟用低數據模式的連線。下載內容、喜好項目和播放記錄會另外儲存。"
          }
        }
      }
    },
