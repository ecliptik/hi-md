          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上播放音樂後會顯示在這裡。"
          }
        }
      }
    },
    "Download albums or playlists on your iPhone to play them here without a connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
