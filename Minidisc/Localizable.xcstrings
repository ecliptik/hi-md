    "Songs are saved by artist, album and title, so Minidisc can find them on the server again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel werden nach Künstler, Album und Titel gesichert, damit Minidisc sie auf dem Server wiederfindet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τραγούδια αποθηκεύονται κατά καλλιτέχνη, άλμπουμ και τίτλο, ώστε το Minidisc να τα βρίσκει ξανά στον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones se guardan por artista, álbum y título para que Minidisc vuelva a encontrarlas en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres sont enregistrés par artiste, album et titre, pour que Minidisc les retrouve sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani vengono salvati per artista, album e titolo, così Minidisc può ritrovarli sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲はアーティスト、アルバム、タイトルで保存されるので、Minidiscがサーバ上で再び見つけられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌曲按艺人、专辑和标题存储，以便 Minidisc 能在服务器上再次找到它们。"
