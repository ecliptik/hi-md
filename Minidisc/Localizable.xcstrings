        }
      }
    },
    "Lidarr could not match this release to an artist and album, so it may not import on its own. Grab it anyway?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr konnte dieses Release keinem Künstler und Album zuordnen und importiert es daher möglicherweise nicht automatisch. Trotzdem abrufen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr δεν μπόρεσε να αντιστοιχίσει αυτή την κυκλοφορία με καλλιτέχνη και άλμπουμ, οπότε ίσως να μην εισαχθεί από μόνη της. Λήψη ούτως ή άλλως;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr no pudo asociar este lanzamiento con un artista y un álbum, por lo que puede que no se importe por sí solo. ¿Obtenerlo de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr n'a pas pu associer cette sortie à un artiste et un album, elle risque donc de ne pas s'importer d'elle-même. La récupérer quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr non è riuscito ad associare questa release a un artista e a un album, quindi potrebbe non importarsi da sola. Prelevarla comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrはこのリリースをアーティストとアルバムに一致させられなかったため、自動ではインポートされない可能性があります。それでも取得しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 无法将此发行版匹配到艺人和专辑，因此可能不会自动导入。仍要抓取吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 無法將此發行版匹配到藝人和專輯，因此可能不會自動匯入。仍要抓取嗎？"
          }
        }
      }
    },
    "Lidarr could not parse this release. Choose the album it belongs to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr konnte dieses Release nicht analysieren. Wähle das zugehörige Album."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr δεν μπόρεσε να αναλύσει αυτή την κυκλοφορία. Επιλέξτε το άλμπουμ στο οποίο ανήκει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr no pudo analizar este lanzamiento. Elige el álbum al que pertenece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr n'a pas pu analyser cette sortie. Choisissez l'album auquel elle appartient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr non è riuscito ad analizzare questa release. Scegli l’album a cui appartiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrはこのリリースを解析できませんでした。属するアルバムを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 无法解析此发行版。请选择它所属的专辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 無法解析此發行版。請選擇它所屬的專輯。"
          }
        }
      }
    },
    "Lidarr found no files to import for this download." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr hat für diesen Download keine Dateien zum Importieren gefunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr δεν βρήκε αρχεία προς εισαγωγή για αυτή τη λήψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr no encontró archivos para importar de esta descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr n'a trouvé aucun fichier à importer pour ce téléchargement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr non ha trovato file da importare per questo download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrはこのダウンロードでインポートするファイルを見つけられませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 未找到此下载可导入的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 未找到此下載可匯入的檔案。"
          }
        }
      }
    },
    "Lidarr is not connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr ist nicht verbunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr δεν είναι συνδεδεμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr no está conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr n'est pas connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr non è connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrが接続されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 未连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 未連接。"
          }
        }
      }
    },
    "Lidarr manages your music collection and downloads new releases for you. Connect it to check its status from Minidisc." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr verwaltet deine Musiksammlung und lädt neue Releases für dich herunter. Verbinde es, um seinen Status in Minidisc zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr διαχειρίζεται τη μουσική σας συλλογή και κατεβάζει νέες κυκλοφορίες για εσάς. Συνδέστε το για να ελέγχετε την κατάστασή του από το Minidisc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr gestiona tu colección de música y descarga los nuevos lanzamientos por ti. Conéctalo para comprobar su estado desde Minidisc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr gère votre collection musicale et télécharge les nouvelles sorties pour vous. Connectez-le pour consulter son état depuis Minidisc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr gestisce la tua collezione musicale e scarica le nuove release per te. Collegalo per controllarne lo stato da Minidisc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrは音楽コレクションを管理し、新しいリリースを自動でダウンロードします。接続すると、Minidiscからその状態を確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 管理你的音乐收藏并为你下载新发行版。连接后即可从 Minidisc 查看其状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 管理你的音樂收藏並為你下載新發行版。連接後即可從 Minidisc 查看其狀態。"
          }
        }
      }
    },
