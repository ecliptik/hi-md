    "Indexing stopped after repeated recommendation failures. Your completed index data was kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Indizierung wurde nach wiederholten Fehlern beim Abrufen von Empfehlungen gestoppt. Bereits erstellte Indexdaten wurden beibehalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ευρετηρίαση σταμάτησε μετά από επανειλημμένες αποτυχίες λήψης προτάσεων. Τα δεδομένα που είχαν ήδη ευρετηριαστεί διατηρήθηκαν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La indexación se detuvo tras varios fallos al obtener recomendaciones. Se conservaron los datos ya indexados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indexation a été arrêtée après plusieurs échecs de récupération des recommandations. Les données déjà indexées ont été conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indicizzazione si è interrotta dopo ripetuti errori nel recupero dei consigli. I dati già indicizzati sono stati conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめの取得に繰り返し失敗したため、インデックス作成を停止しました。作成済みのインデックスデータは保持されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于多次获取推荐失败，索引已停止。已完成的索引数据已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於多次取得推薦失敗，索引已停止。已完成的索引資料已保留。"
          }
        }
      }
    },
