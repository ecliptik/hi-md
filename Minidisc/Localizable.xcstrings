          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναφορά εξαιρεί μεταδεδομένα τραγουδιών, πλήρεις διευθύνσεις URL διακομιστή, διαπιστευτήρια, κεφαλίδες HTTP και ονόματα συσκευών ήχου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
