    "Minidisc couldn't turn that into a search. Try naming a genre, decade, artist or mood." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc konnte daraus keine Suche machen. Nenne ein Genre, ein Jahrzehnt, einen Künstler oder eine Stimmung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Minidisc δεν μπόρεσε να το μετατρέψει σε αναζήτηση. Δοκιμάστε ένα είδος, δεκαετία, καλλιτέχνη ή διάθεση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc no pudo convertir eso en una búsqueda. Prueba a indicar un género, una década, un artista o un estado de ánimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc n'a pas pu en faire une recherche. Essayez d'indiquer un genre, une décennie, un artiste ou une ambiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc non è riuscito a trasformarlo in una ricerca. Prova a indicare un genere, un decennio, un artista o un'atmosfera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidiscはそれを検索に変換できませんでした。ジャンル、年代、アーティスト、雰囲気を指定してみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc 无法将其转换为搜索。请尝试指定风格、年代、艺人或情绪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc 無法將其轉換為搜尋。請嘗試指定風格、年代、藝人或情緒。"
          }
        }
      }
    },
    "Your library index isn't ready yet. Try again after it syncs." : {
