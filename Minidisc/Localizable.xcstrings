    "Higher bitrates sound closer to the original and use more data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Bitraten klingen näher am Original und verbrauchen mehr Daten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι υψηλότεροι ρυθμοί bit ακούγονται πιο κοντά στο πρωτότυπο και χρησιμοποιούν περισσότερα δεδομένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tasas de bits más altas suenan más parecidas al original y usan más datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un débit plus élevé sonne plus près de l’original et consomme plus de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bitrate più alti suonano più vicini all'originale e usano più dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットレートが高いほど元の音に近くなり、使用するデータも増えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比特率越高，听起来越接近原始文件，用的流量也越多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位元率越高，聽起來越接近原始檔案，使用的數據也越多。"
          }
        }
      }
    },
    "Holds peaks below full scale, so the preamp, ReplayGain and the equalizer never clip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Spitzen unter Vollaussteuerung, damit Vorverstärkung, ReplayGain und Equalizer nie übersteuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατά τις κορυφές κάτω από την πλήρη κλίμακα, ώστε η προενίσχυση, το ReplayGain και ο ισοσταθμιστής να μην προκαλούν ποτέ clipping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene los picos por debajo de la escala completa para que el preamplificador, ReplayGain y el ecualizador nunca saturen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient les crêtes sous la pleine échelle, pour que le préampli, ReplayGain et l’égaliseur ne saturent jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene i picchi sotto il fondo scala, così preamplificatore, ReplayGain ed equalizzatore non vanno mai in clipping."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピークをフルスケール未満に保ち、プリアンプ、ReplayGain、イコライザでクリッピングしないようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将峰值保持在满刻度以下，让前置放大、ReplayGain 和均衡器都不会削波。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將峰值維持在滿刻度以下，讓前置放大、ReplayGain 和等化器都不會削峰失真。"
          }
        }
      }
    },
