    "Applies to streamed and downloaded music, including crossfades." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für gestreamte und geladene Musik, auch bei Überblendungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για μουσική ροής και ληφθείσα, συμπεριλαμβανομένων των διασταυρώσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la música en streaming y descargada, incluidos los fundidos cruzados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique à la musique diffusée et téléchargée, fondus enchaînés compris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica alla musica in streaming e scaricata, incluse le dissolvenze incrociate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリーミングとダウンロードした音楽に、クロスフェードも含めて適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于流式播放和已下载的音乐，包括交叉淡入淡出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於串流播放和已下載的音樂，包括交叉淡入淡出。"
          }
        }
      }
    },
    "Lower the preamp if boosted bands sound distorted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Vorverstärkung, wenn angehobene Bänder verzerrt klingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μειώστε την προενίσχυση αν οι ενισχυμένες ζώνες ακούγονται παραμορφωμένες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el preamplificador si las bandas realzadas suenan distorsionadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baissez le préampli si les bandes amplifiées sonnent saturées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa il preamplificatore se le bande amplificate risultano distorte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強調したバンドが歪む場合はプリアンプを下げてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果提升的频段听起来失真，请调低前置放大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果提升的頻段聽起來失真，請調低前置放大。"
          }
        }
