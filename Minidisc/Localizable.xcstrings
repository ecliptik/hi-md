    "LRCLIB is temporarily rate-limiting requests. Try again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LRCLIB begrenzt Anfragen vorübergehend. Versuche es später erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το LRCLIB περιορίζει προσωρινά τα αιτήματα. Δοκιμάστε ξανά αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
