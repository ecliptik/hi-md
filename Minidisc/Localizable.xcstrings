    "With the limiter off, ReplayGain stops at each song's peak instead, which can leave quiet songs quieter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Limiter hört ReplayGain stattdessen an der Spitze jedes Songs auf, wodurch leise Songs leiser bleiben können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τον περιοριστή απενεργοποιημένο, το ReplayGain σταματά στην κορυφή κάθε τραγουδιού, κάτι που μπορεί να αφήσει τα ήσυχα τραγούδια πιο σιγανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el limitador desactivado, ReplayGain se detiene en el pico de cada canción, lo que puede dejar más bajas las canciones suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans limiteur, ReplayGain s’arrête au pic de chaque morceau, ce qui peut laisser les morceaux calmes plus faibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il limitatore spento, ReplayGain si ferma al picco di ogni brano, e i brani tranquilli possono restare più bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リミッターをオフにすると、ReplayGainは各曲のピークで止まるため、静かな曲は小さいままになることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭限幅器后，ReplayGain 会止于每首歌的峰值，安静的歌可能因此偏小声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉限幅器後，ReplayGain 會止於每首歌的峰值，安靜的歌可能因此偏小聲。"
          }
        }
      }
    },
    "Your server couldn't list this folder: %@" : {
