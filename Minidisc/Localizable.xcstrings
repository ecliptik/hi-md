    },
    "The hostname could not be resolved. Check the URL, that your VPN (such as Tailscale) is connected, and local network access in iOS Settings › Privacy › Local Network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hostname konnte nicht aufgelöst werden. URL, die Verbindung des VPN (z. B. Tailscale) und lokalen Netzwerkzugriff in iOS Einstellungen › Datenschutz › Lokales Netzwerk prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάλυση του ονόματος κεντρικού υπολογιστή. Ελέγξτε το URL, ότι το VPN σας (όπως το Tailscale) είναι συνδεδεμένο και την πρόσβαση στο τοπικό δίκτυο στο iOS Ρυθμίσεις › Απόρρητο › Τοπικό δίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo resolver el nombre de host. Comprueba la URL, que tu VPN (como Tailscale) esté conectada y el acceso a la red local en Ajustes de iOS › Privacidad › Red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'hôte n'a pas pu être résolu. Vérifiez l'URL, que votre VPN (comme Tailscale) est connecté et l'accès au réseau local dans Réglages iOS › Confidentialité › Réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile risolvere l'hostname. Controlla l'URL, che la VPN (come Tailscale) sia connessa e l'accesso alla rete locale in Impostazioni iOS › Privacy › Rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト名を解決できませんでした。URL、VPN（Tailscaleなど）が接続されていること、およびiOSの設定 › プライバシー › ローカルネットワークでのローカルネットワークアクセスを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解析主机名。请检查 URL、VPN（如 Tailscale）是否已连接，以及 iOS 设置 › 隐私 › 本地网络 中的本地网络访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法解析主機名稱。請檢查 URL、VPN（例如 Tailscale）是否已連線，以及 iOS「設定」›「隱私權」›「區域網路」中的區域網路存取權限。"
          }
        }
      }
    },
