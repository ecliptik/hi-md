    "Autoplay songs count as plays: scrobbles, ListenBrainz and Recently Played." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoplay-Songs zählen als Wiedergaben: Scrobbles, ListenBrainz und „Kürzlich gespielt“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τραγούδια της αυτόματης αναπαραγωγής μετρούν ως ακροάσεις: scrobbles, ListenBrainz και Ακούστηκαν πρόσφατα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones de la reproducción automática cuentan como reproducciones: scrobbles, ListenBrainz y Reproducido recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les morceaux de la lecture automatique comptent comme des écoutes : scrobbles, ListenBrainz et Écoutés récemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani della riproduzione automatica contano come ascolti: scrobble, ListenBrainz e Riprodotti di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
