        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrはこのアーティストの管理を停止します。ダウンロード済みのファイルは保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
