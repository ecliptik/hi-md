    "Only show and play music saved on this device, even when connected to the internet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei bestehender Internetverbindung nur auf diesem Gerät gespeicherte Musik anzeigen und abspielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση και αναπαραγωγή μόνο της μουσικής που είναι αποθηκευμένη σε αυτή τη συσκευή, ακόμη και με σύνδεση στο διαδίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar y reproducir solo la música guardada en este dispositivo, incluso con conexión a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher et lire uniquement la musique enregistrée sur cet appareil, même avec une connexion Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra e riproduci solo la musica salvata su questo dispositivo, anche quando è connesso a internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットに接続していても、このデバイスに保存された音楽のみを表示・再生します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使已连接互联网，也仅显示和播放保存在此设备上的音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使已連接網際網路，也僅顯示和播放儲存在此裝置上的音樂。"
          }
        }
      }
    },
