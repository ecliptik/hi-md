    "Use the server's host name or IPv4 address instead. With Tailscale, use the MagicDNS name or the 100.x address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen den Hostnamen oder die IPv4-Adresse des Servers verwenden. Bei Tailscale den MagicDNS-Namen oder die 100.x-Adresse verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε αντί γι' αυτό το όνομα κεντρικού υπολογιστή ή τη διεύθυνση IPv4 του διακομιστή. Με το Tailscale, χρησιμοποιήστε το όνομα MagicDNS ή τη διεύθυνση 100.x."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa en su lugar el nombre de host o la dirección IPv4 del servidor. Con Tailscale, usa el nombre de MagicDNS o la dirección 100.x."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez plutôt le nom d'hôte ou l'adresse IPv4 du serveur. Avec Tailscale, utilisez le nom MagicDNS ou l'adresse 100.x."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa invece il nome host o l'indirizzo IPv4 del server. Con Tailscale, usa il nome MagicDNS o l'indirizzo 100.x."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりにサーバのホスト名またはIPv4アドレスを使用してください。Tailscaleの場合は、MagicDNS名または100.xアドレスを使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请改用服务器的主机名或 IPv4 地址。使用 Tailscale 时，请使用 MagicDNS 名称或 100.x 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請改用伺服器的主機名稱或 IPv4 位址。使用 Tailscale 時，請使用 MagicDNS 名稱或 100.x 位址。"
          }
        }
      }
    },
    "IPv6 addresses are not supported." : {
