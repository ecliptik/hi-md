    "Overrides the colour taken from the cover, here and anywhere else this playlist appears." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschreibt die vom Cover übernommene Farbe – hier und überall sonst, wo diese Playlist angezeigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντικαθιστά το χρώμα που λαμβάνεται από το εξώφυλλο, εδώ και οπουδήποτε αλλού εμφανίζεται αυτή η λίστα αναπαραγωγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye el color tomado de la portada, aquí y en cualquier otro lugar donde aparezca esta lista de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
