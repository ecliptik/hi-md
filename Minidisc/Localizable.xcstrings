    "Reconnect to browse Lidarr and manage your music library. Your offline music is still available in Minidisc." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle die Verbindung wieder her, um Lidarr zu durchsuchen und deine Musikbibliothek zu verwalten. Deine Offline-Musik bleibt in Minidisc verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου ξανά για περιήγηση στο Lidarr και διαχείριση της μουσικής βιβλιοθήκης σου. Η μουσική σου εκτός σύνδεσης παραμένει διαθέσιμη στο Minidisc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectarte para explorar Lidarr y gestionar tu biblioteca musical. Tu música sin conexión sigue disponible en Minidisc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez-vous pour consulter Lidarr et gérer votre bibliothèque musicale. Votre musique hors ligne reste disponible dans Minidisc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconnettiti per esplorare Lidarr e gestire la tua libreria musicale. La musica offline resta disponibile in Minidisc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再接続すると、Lidarrの閲覧や音楽ライブラリの管理ができます。オフラインの音楽は引き続きMinidiscで再生できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新连接后即可浏览 Lidarr 并管理音乐库。你仍可在 Minidisc 中收听离线音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新連線即可瀏覽 Lidarr 並管理音樂資料庫。你仍可在 Minidisc 中收聽離線音樂。"
          }
        }
