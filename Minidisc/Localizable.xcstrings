    "Keys are stored in the keychain on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel werden im Schlüsselbund dieses Geräts gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλειδιά αποθηκεύονται στην κλειδοθήκη αυτής της συσκευής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se guardan en el llavero de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés sont enregistrées dans le trousseau de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi sono salvate nel portachiavi di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはこのデバイスのキーチェーンに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥存储在此设备的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰儲存在此裝置的鑰匙圈中。"
          }
        }
      }
    },
    "Apple Intelligence runs on this device. Anthropic and OpenAI receive the names of your recently played and favourite albums, most collected artists and playlists, and use your own API key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence läuft auf diesem Gerät. Anthropic und OpenAI erhalten die Namen deiner zuletzt gespielten und favorisierten Alben, meistgesammelten Künstler und Playlists und nutzen deinen eigenen API-Schlüssel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Apple Intelligence εκτελείται σε αυτή τη συσκευή. Η Anthropic και η OpenAI λαμβάνουν τα ονόματα των πρόσφατων και αγαπημένων άλμπουμ, των καλλιτεχνών με τα περισσότερα άλμπουμ και των λιστών σας, και χρησιμοποιούν το δικό σας κλειδί API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence se ejecuta en este dispositivo. Anthropic y OpenAI reciben los nombres de tus álbumes recientes y favoritos, tus artistas más coleccionados y tus playlists, y usan tu propia clave de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence s'exécute sur cet appareil. Anthropic et OpenAI reçoivent les noms de vos albums récents et favoris, de vos artistes les plus présents et de vos playlists, et utilisent votre propre clé d'API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence funziona su questo dispositivo. Anthropic e OpenAI ricevono i nomi dei tuoi album recenti e preferiti, degli artisti più presenti e delle playlist, e usano la tua chiave API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceはこのデバイス上で動作します。AnthropicとOpenAIには、最近再生した曲やお気に入りのアルバム、よく集めているアーティスト、プレイリストの名前が送信され、あなた自身のAPIキーが使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 智能在此设备上运行。Anthropic 和 OpenAI 会收到你最近播放和收藏的专辑、收藏最多的艺人和播放列表的名称，并使用你自己的 API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 在此裝置上執行。Anthropic 和 OpenAI 會收到你最近播放和收藏的專輯、收藏最多的藝人和播放列表的名稱，並使用你自己的 API 金鑰。"
          }
        }
      }
    },
    "Apple Intelligence isn't available on this device right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist auf diesem Gerät gerade nicht verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Apple Intelligence δεν είναι διαθέσιμο σε αυτή τη συσκευή αυτή τη στιγμή."
